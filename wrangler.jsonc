{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amqtours-gatcha",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "Game" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
