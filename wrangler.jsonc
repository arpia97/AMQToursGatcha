{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amqtours-gatcha",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": { "BACKGROUND_IMPORT_MODE": "continuous", "PAYPAL_LIVE_ENABLED": "1" },
  "kv_namespaces": [{"binding":"EVENT_CLIPS","id":"56d982feded246cb87e0eb0831ac55c9"}],
  "d1_databases": [{"binding":"GAME_RECORDS","database_name":"amqtours-game-records","database_id":"687446ba-799f-4512-9231-4faa775e18a3"}],
  "triggers": { "crons": ["12 4 * * SUN","*/2 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/play", "/play/*", "/quiz-library/master-answers.json"],
  },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "Game" }, { "name": "QUIZ_LIBRARY", "class_name": "QuizLibrary" }, { "name": "QUIZ_SESSIONS", "class_name": "QuizSession" }, { "name": "PLAY_QUEUE", "class_name": "PlayQueue" }, { "name": "PLAY_MATCHES", "class_name": "PlayMatch" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }, { "tag": "v2-quiz-library", "new_sqlite_classes": ["QuizLibrary"] }, { "tag": "v3-quiz-sessions", "new_sqlite_classes": ["QuizSession"] }, { "tag": "v4-play-matches", "new_sqlite_classes": ["PlayQueue", "PlayMatch"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
