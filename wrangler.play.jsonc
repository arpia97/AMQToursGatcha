{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "workers_dev": true,
  "routes": [
    { "pattern": "amqtours.app/gacha", "zone_name": "amqtours.app" },
    { "pattern": "amqtours.app/gacha/*", "zone_name": "amqtours.app" }
  ],
  "main": "src/short-url.js",
  "compatibility_date": "2026-10-23",
  "services": [{ "binding": "GAME_SITE", "service": "amqtours-gatcha" }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
